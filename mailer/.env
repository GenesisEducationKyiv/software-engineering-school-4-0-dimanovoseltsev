# yii
YII_DEBUG="true"
YII_ENV="dev"

# mysql
DB_DSN=mysql:host=mysql-currency-rates;port=3306;dbname=mailer
DB_USERNAME=db_user
DB_PASSWORD=db_pass
DB_TABLE_PREFIX=
DB_CHARSET=utf8mb4
DB_SCHEMA_CACHE_DURATION=31536000

# Memcache
MEMCACHE_HOST=memcached-currency-rates
MEMCACHE_PORT=11211

#mailer
MAILER_DSN="smtp://74f9b5001@smtp-brevo.com:OGJ2kwBN7fDacULM@smtp-relay.brevo.com:587"
MAILER_DEBUG=0

SENDER_EMAIL="robot-currency-rates@smtp-brevo.com"
SENDER_NAME="CurrencyRates"
SUBSCRIPTIONS_SUBJECT_EMAIL="Actual rate"

# RabbitMQ
RABBITMQ_HOST=rabbitmq-currency-rates
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EVENT_BUS_EXCHANGE=events-exchange
RABBITMQ_DEFAULT_HEARTBEAT=600

RABBITMQ_SEND_EMAIL_QUEUE=send-email-queue
RABBITMQ_SEND_EMAIL_EXCHANGE=send-email-exchange
RABBITMQ_SEND_EMAIL_ROUTING_KEY=send-email
RABBITMQ_SEND_EMAIL_FAIL_QUEUE=send-email-fail-queue
RABBITMQ_SEND_EMAIL_FAIL_EXCHANGE=send-email-fail-exchange
RABBITMQ_SEND_EMAIL_FAIL_ROUTING_KEY=send-email-fail
SEND_EMAIL_QUEUE_MAX_ATTEMPT=5

RABBITMQ_SUBSCRIPTION_QUEUE=subscription-queue
RABBITMQ_SUBSCRIPTION_EXCHANGE=subscription-exchange
RABBITMQ_SUBSCRIPTION_ROUTING_KEY=subscription
RABBITMQ_SUBSCRIPTION_CREATE_ROUTING_KEY=subscription.create
RABBITMQ_SUBSCRIPTION_DELETE_ROUTING_KEY=subscription.delete
RABBITMQ_SUBSCRIPTION_FAIL_QUEUE=subscription-fail-queue
RABBITMQ_SUBSCRIPTION_FAIL_EXCHANGE=subscription-fail-exchange
RABBITMQ_SUBSCRIPTION_FAIL_ROUTING_KEY=subscription-fail
SUBSCRIPTION_QUEUE_MAX_ATTEMPT=5

RABBITMQ_CURRENCY_QUEUE=currency-queue
RABBITMQ_CURRENCY_EXCHANGE=currency-exchange
RABBITMQ_CURRENCY_ROUTING_KEY=currency
RABBITMQ_CURRENCY_UPDATE_ROUTING_KEY=currency.update
RABBITMQ_CURRENCY_FAIL_QUEUE=currency-fail-queue
RABBITMQ_CURRENCY_FAIL_EXCHANGE=currency-fail-exchange
RABBITMQ_CURRENCY_FAIL_ROUTING_KEY=currency-fail
CURRENCY_QUEUE_MAX_ATTEMPT=5
